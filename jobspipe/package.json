{
  "name": "jobspipe",
  "description": "JobsPipe integration for Attio - View company hiring data and enrich records",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "attio": "attio",
    "dev": "attio dev",
    "build": "attio build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "clean": "rm -rf lib && rm -rf dist",
    "lint": "npm run lint:biome",
    "lint:biome": "biome lint src/",
    "lint:biome:fix": "biome lint --write src/",
    "lint:fix": "npm run lint:biome:fix",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^24.0.4",
    "@types/react": "19.2.14",
    "@typescript-eslint/parser": "^8.34.1",
    "eslint": "^9.29.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "attio": "latest",
    "react": "19.2.4",
    "zod": "3.25.67"
  }
}
